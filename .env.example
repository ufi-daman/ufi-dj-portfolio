# Zkopíruj tento soubor jako .env a vyplň hodnoty
# cp .env.example .env

# Facebook Page ID (číslo — najdeš ho na stránce About nebo přes Graph API Explorer)
FB_PAGE_ID=123456789012345

# Page Access Token (Long-lived, nikdy nevypršuje pokud správně nastaveno)
# Jak ho získat: viz README nebo návod níže
FB_ACCESS_TOKEN=EAAxxxxxxxxxxxxxx

# URL frontendu — omezí CORS pouze na tvůj web (v produkci nastav konkrétní doménu)
ALLOWED_ORIGIN=https://ufidaman.com

# Port serveru (Render, Railway atd. si nastaví PORT sami)
PORT=3000
